.worktrees/
node_modules/
cloudflare/node_modules/

# Database backups — contain scan data, keep local only
*.sql
ratcatcher-db-backup-*.sql
# But DO track migrations and the canonical schema (existing 0004/0005 were
# tracked before the *.sql rule existed; new migrations would be silently
# dropped without these negations).
!cloudflare/migrations/*.sql
!cloudflare/schema.sql

# Error capture files (transient)
*.rtf

# Claude Code local settings — per-machine, not shared
.claude/

# Stray clones / copies — the canonical tree is the repo root, period.
# These showed up across multiple sessions as untracked artifacts. If you
# need a working copy, use git worktree, not a sub-folder clone.
/RatCatcher/
/cloudflare/RatCatcher/
